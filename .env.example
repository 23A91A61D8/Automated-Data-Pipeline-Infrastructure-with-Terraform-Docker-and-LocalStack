# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env for local overrides
# ==============================================================================

# ------------------------------------------------------------------------------
# AWS & LocalStack Connection Configuration
# ------------------------------------------------------------------------------
# For host execution (running Python/Terraform directly on your machine):
#   AWS_ENDPOINT_URL=http://localhost:4566
# For Docker Compose execution (inside the Docker container network):
#   AWS_ENDPOINT_URL=http://localstack:4566
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# Dummy credentials required for LocalStack API authentication
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ------------------------------------------------------------------------------
# Pipeline & S3 Storage Configuration
# ------------------------------------------------------------------------------
S3_BUCKET_NAME=my-pipeline-bucket
RAW_DATA_KEY=raw/input.csv
PROCESSED_DATA_KEY=processed/output.csv

# ------------------------------------------------------------------------------
# Terraform Input Variables (TF_VAR_*)
# ------------------------------------------------------------------------------
TF_VAR_aws_region=us-east-1
TF_VAR_s3_bucket_name=my-pipeline-bucket
TF_VAR_localstack_endpoint=http://localhost:4566
TF_VAR_environment=dev
