# ==============================================================================
# Docker Ignore Configuration
# Excludes unnecessary files and directories from the Docker build context
# ==============================================================================

.git
.github
.gitignore
infrastructure/
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.env
.env.*
.venv/
venv/
tests/
data/
scripts/
docs/
*.md
*.log
.pytest_cache/
.coverage
htmlcov/
